generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  TRIAL
  SCHOLAR
  RESEARCHER
  ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  PAST_DUE
  CANCELED
  TRIALING
  PAUSED
}

enum OAuthProvider {
  GOOGLE
  MICROSOFT
  GITHUB
  APPLE
}

enum GenerationStatus {
  COMPLETED
  FAILED
  RATE_LIMITED
}

enum AuditSeverity {
  INFO
  WARN
  ERROR
  CRITICAL
}

enum ExportStatus {
  PENDING
  PROCESSING
  READY
  EXPIRED
  FAILED
}

model User {
  id                  String              @id @default(uuid())
  email               String              @unique
  emailVerified       Boolean             @default(false)
  emailVerifiedAt     DateTime?
  passwordHash        String?
  fullName            String
  avatarUrl           String?
  plan                Plan                @default(TRIAL)
  trialStartedAt      DateTime            @default(now())
  trialEndsAt         DateTime?
  subscriptionId      String?             @unique
  subscriptionStatus  SubscriptionStatus  @default(INACTIVE)
  stripeCustomerId    String?             @unique
  oauthProvider       OAuthProvider?
  oauthProviderId     String?
  mfaEnabled          Boolean             @default(false)
  mfaSecret           String?
  mfaBackupCodes      String[]            @default([])
  dailyUsageCount     Int                 @default(0)
  dailyUsageReset     DateTime            @default(now())
  totalGenerations    Int                 @default(0)
  termsAcceptedAt     DateTime?
  privacyAcceptedAt   DateTime?
  marketingConsent    Boolean             @default(false)
  dataRetentionDays   Int                 @default(365)
  lastLoginAt         DateTime?
  lastLoginIp         String?
  loginAttempts       Int                 @default(0)
  lockedUntil         DateTime?
  sessionTokenHash    String?
  deletedAt           DateTime?
  deletionRequestedAt DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  sessions      Session[]
  generations   Generation[]
  subscriptions Subscription[]
  auditLogs     AuditLog[]
  dataExports   DataExport[]

  @@index([email])
  @@index([stripeCustomerId])
  @@index([oauthProvider, oauthProviderId])
  @@index([deletedAt])
}

model Session {
  id          String   @id @default(uuid())
  userId      String
  tokenHash   String   @unique
  ipAddress   String?
  userAgent   String?
  mfaVerified Boolean  @default(false)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model Generation {
  id           String           @id @default(uuid())
  userId       String
  tool         String
  subTool      String
  model        String
  inputTokens  Int
  outputTokens Int
  costUsd      Float
  promptHash   String?
  outputSize   Int
  status       GenerationStatus @default(COMPLETED)
  errorMessage String?
  durationMs   Int?
  createdAt    DateTime         @default(now())
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tool])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model Subscription {
  id                   String             @id @default(uuid())
  userId               String
  stripeSubscriptionId String             @unique
  stripePriceId        String
  plan                 Plan
  status               SubscriptionStatus
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stripeSubscriptionId])
}

model AuditLog {
  id         String        @id @default(uuid())
  userId     String?
  action     String
  resource   String?
  resourceId String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  severity   AuditSeverity @default(INFO)
  createdAt  DateTime      @default(now())
  user       User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([severity])
}

model DataExport {
  id          String       @id @default(uuid())
  userId      String
  status      ExportStatus @default(PENDING)
  downloadUrl String?
  expiresAt   DateTime?
  requestedAt DateTime     @default(now())
  completedAt DateTime?
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WebhookEvent {
  id            String   @id @default(uuid())
  stripeEventId String   @unique
  type          String
  processed     Boolean  @default(false)
  processedAt   DateTime?
  payload       Json
  createdAt     DateTime @default(now())

  @@index([stripeEventId])
  @@index([processed])
}
